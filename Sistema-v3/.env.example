# Copiar a .env en local, o pegar como Environment Variables en Railway/Render
PORT=3000
NODE_ENV=production
SESSION_SECRET=cambia-esto-por-un-string-largo-aleatorio
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario
# Poner true si el proveedor MySQL exige SSL (Clever Cloud, PlanetScale, Aiven)
DB_SSL=false
